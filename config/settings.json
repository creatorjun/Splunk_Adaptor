{
  "schema_version": 1,
  "role": "col",
  "process_monitor": {
    "anal": [
      "SearchEngine",
      "Normalizer",
      "CollectorForAgent",
      "CDMEngine",
      "ShovelServer",
      "AnalyzeEngine",
      "AnalyzeAssistantEngine",
      "SoarTicketMain",
      "SoarPlaybookManager",
      "pmsServer",
      "pmsClient",
      "ProcessMonitor"
    ],
    "col": [
      "SearchEngine",
      "Reducer",
      "Normalizer",
      "CloudESMCollector",
      "CollectorForAgent",
      "CDMEngine",
      "pmsClient",
      "ProcessMonitor"
    ],
    "prx": [
      "CollectorForAgent"
    ]
  },
  "collection": {
    "interval_seconds": 60,
    "output_directory": "/Monitor"
  },
  "retention": {
    "enabled": true,
    "max_age_seconds": 3600
  },
  "processing_files": {
    "thresholds": {
      "collector": {
        "tmp_count": 100,
        "done_count": 100
      },
      "normalize": {
        "tmp_count": 100,
        "done_count": 100
      }
    }
  },
  "thresholds": {
    "cpu_usage_percent": 80.0,
    "memory_usage_percent": 85.0,
    "storage_usage_percent": 90.0
  },
  "relay_log": {
    "path": "/CloudESM/logs/CollectorForAgent.log"
  },
  "mysql": {
    "host": "127.0.0.1",
    "port": 3306,
    "database": "CloudESM",
    "credentials_file": "/etc/resource-monitor/secrets/mysql.json",
    "connect_timeout_seconds": 3,
    "read_timeout_seconds": 3,
    "write_timeout_seconds": 3,
    "tls_mode": "verify_identity",
    "tls_ca_file": "/etc/resource-monitor/secrets/mysql-ca.pem"
  }
}
