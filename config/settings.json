{
  "schema_version": 1,
  "is_analyzer": false,
  "analyzer": {
    "collect_count_change_percent": 10.0,
    "comparison_day": "yesterday"
  },
  "process_monitor": {
    "analyzer": [
      "SearchEngine",
      "Normalizer",
      "CollectorForAgent",
      "CDMEngine",
      "ShovelServer",
      "AnalyzeEngine",
      "AnalyzeAssistantEngine",
      "SoarTicketMain",
      "SoarPlaybookManager",
      "pmsServer",
      "pmsClient",
      "ProcessMonitor"
    ],
    "collector": [
      "SearchEngine",
      "Reducer",
      "Normalizer",
      "CloudESMCollector",
      "CollectorForAgent",
      "CDMEngine",
      "pmsClient",
      "ProcessMonitor"
    ]
  },
  "collection": {
    "interval_seconds": 60,
    "output_directory": "/Monitor"
  },
  "processing_files": {
    "thresholds": {
      "collector": {
        "tmp_count": 100,
        "done_count": 100
      },
      "normalize": {
        "tmp_count": 100,
        "done_count": 100
      }
    }
  },
  "thresholds": {
    "cpu_usage_percent": 80.0,
    "memory_usage_percent": 85.0,
    "storage_usage_percent": 90.0
  },
  "log_silence": {
    "default_timeout_seconds": 300,
    "overrides": []
  },
  "mysql": {
    "host": "127.0.0.1",
    "port": 3306,
    "database": "monitoring",
    "credentials_file": "/etc/resource-monitor/secrets/mysql.json",
    "connect_timeout_seconds": 3,
    "read_timeout_seconds": 3,
    "write_timeout_seconds": 3,
    "tls_mode": "verify_identity",
    "tls_ca_file": "/etc/resource-monitor/secrets/mysql-ca.pem"
  }
}
